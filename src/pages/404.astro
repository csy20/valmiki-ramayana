---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
---
<Base title="Page Not Found">
  <section class="measure">
    <h1 class="text-3xl font-bold tracking-tight">404 &mdash; Page Not Found</h1>
    <p class="mt-3 text-sm text-[var(--muted)]">
      The requested sarga or page does not exist. Try returning home or searching across the Rāmāyaṇa.
    </p>
    <div class="mt-6 flex gap-3 text-sm">
      <a href={withBase('')} class="rounded bg-[var(--accent)] px-4 py-2 font-medium text-[var(--accent-ink)] no-underline">Home</a>
      <a href={withBase('search/')} class="rounded border border-[var(--border)] bg-[var(--surface)] px-4 py-2 font-medium no-underline">Search</a>
    </div>
  </section>
</Base>
