---
<div class="mb-4 flex flex-wrap items-center justify-between gap-2 rounded-lg border border-[var(--border)] bg-[var(--surface)]/75 px-2.5 py-2 text-sm" role="region" aria-label="Reading display controls">
  <div class="flex flex-wrap items-center gap-1" role="group" aria-label="Text layers">
    <button type="button" data-layer="sa" aria-pressed="true" class="layer-pill rounded-md px-2.5 py-1 text-xs font-medium sm:text-sm">
      <span class="deva">देवनागरी</span>
    </button>
    <button type="button" data-layer="iast" aria-pressed="true" class="layer-pill rounded-md px-2.5 py-1 text-xs font-medium sm:text-sm">
      IAST
    </button>
    <button type="button" data-layer="hi" aria-pressed="true" class="layer-pill rounded-md px-2.5 py-1 text-xs font-medium sm:text-sm">
      <span class="deva">हिन्दी</span>
    </button>
    <button type="button" data-layer="en" aria-pressed="true" class="layer-pill rounded-md px-2.5 py-1 text-xs font-medium sm:text-sm">
      English
    </button>
  </div>

  <div class="flex items-center gap-1.5">
    <button
      type="button"
      data-focus-toggle
      aria-pressed="false"
      class="swatch-btn hidden rounded-md px-2.5 py-1 text-xs sm:inline-flex sm:items-center sm:gap-1"
      title="Toggle distraction-free focus mode (f)"
    >
      <span>Focus</span>
    </button>
    <button
      type="button"
      popovertarget="display-pop"
      class="swatch-btn inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-semibold"
      aria-label="Appearance and reading settings"
    >
      <span>Aa</span>
      <span class="text-[var(--muted)]">Display</span>
    </button>
  </div>
</div>

<div id="display-pop" popover="auto" class="vr-popover"></div>
