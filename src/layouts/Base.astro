---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../config';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  showProgress?: boolean;
}

const { title, description = SITE_DESCRIPTION, showProgress = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const baseUrl = withBase('');
---
<!doctype html>
<html lang="en" data-base={baseUrl}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf6ee" />
    <link rel="icon" type="image/svg+xml" href={withBase('icon.svg')} />
    <link rel="manifest" href={withBase('manifest.webmanifest')} />
    <script is:inline>
      (function () {
        var p = { sa: true, iast: true, hi: true, en: true, theme: 'paper', size: 'md', focus: false };
        try {
          var raw = localStorage.getItem('vr:prefs');
          if (raw) Object.assign(p, JSON.parse(raw));
        } catch {}
        var r = document.documentElement;
        r.classList.add('theme-' + (p.theme || 'paper'), 'size-' + (p.size || 'md'));
        if (p.sa === false) r.classList.add('hide-sa');
        if (p.iast === false) r.classList.add('hide-iast');
        if (p.hi === false) r.classList.add('hide-hi');
        if (p.en === false) r.classList.add('hide-en');
        if (p.focus === true) r.classList.add('focus-mode');
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    {showProgress && <div class="read-progress" aria-hidden="true"></div>}
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6 sm:py-8">
      <slot />
    </main>
    <Footer />

    <dialog id="jump-dialog" class="vr-dialog" aria-labelledby="jump-title"></dialog>

    <button id="exit-focus-btn" type="button" class="exit-focus-pill">
      <span>Exit Focus</span>
      <kbd class="rounded border border-[var(--border)] bg-[var(--bg)] px-1 font-mono text-[10px]">f</kbd>
    </button>

    <div id="vr-toast" role="status" aria-live="polite" class="vr-toast" hidden></div>

    <script src="../scripts/site.ts"></script>
  </body>
</html>
